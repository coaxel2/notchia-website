# Cloudflare Pages — security & performance headers
# Doc: https://developers.cloudflare.com/pages/configuration/headers/
# IMPORTANT : un seul bloc par path matcher — sinon le dernier override les précédents.

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-DNS-Prefetch-Control: on
  # CSP appliquée (plus en Report-Only depuis le 2026-08-13) : le site ne charge
  # aucun script tiers (GA4 et Plausible sont commentés), aucune iframe, aucun
  # média externe, et tous les fetch() sont relatifs (/api/*). La redirection
  # Stripe se fait par window.location (navigation, non soumise à connect-src).
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self'; object-src 'none'; frame-src 'none'; worker-src 'self'; manifest-src 'self'; media-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests

# Assets statiques — cache long immutable
/logo.png
  Cache-Control: public, max-age=31536000, immutable
/logo-512.png
  Cache-Control: public, max-age=31536000, immutable
/favicon.png
  Cache-Control: public, max-age=31536000, immutable
/favicon.svg
  Cache-Control: public, max-age=31536000, immutable
/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable
# PAS immutable : l'og-image porte les prix et évolue avec eux. En cache un an,
# elle a servi les anciens tarifs sur chaque partage social de mai à août 2026.
/og-image.png
  Cache-Control: public, max-age=86400
/og-image.svg
  Cache-Control: public, max-age=86400
/Apple_logo_black.svg
  Cache-Control: public, max-age=31536000, immutable

/tailwind.css
  Cache-Control: public, max-age=14400, must-revalidate

# llms.txt / llms-full.txt — accessibles aux LLM mais NON indexés par Google
# Sans X-Robots-Tag noindex, ces fichiers apparaissaient en « Détectée non
# indexée » dans GSC et polluaient le rapport d'indexation.
/llms.txt
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: noindex, follow
/llms-full.txt
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: noindex, follow

# Robots & sitemap
/robots.txt
  Cache-Control: public, max-age=3600, must-revalidate
/sitemap.xml
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: application/xml; charset=utf-8
